    Customer {
        ID IDCustomer PK
        GUID GUIDCustomer
        String Name
        String Description
        String ContactName
        String ContactEmail
        String ContactPhone
        String Address
        String City
        String State
        String Postal
        String Country
        Boolean Active
    }

    User {
        ID IDUser PK
        Numeric IDCustomer FK
        String LoginID
        String Password
        String NameFirst
        String NameLast
        String FullName
        String Email
        String Phone
        String Address
        String City
        String State
        String Postal
        String Country
    }

    Book {
        ID IDBook PK
        Numeric IDCustomer FK
        String Title
        String Type
        String Genre
        String ISBN
        String Language
        String ImageURL
        Numeric PublicationYear
    }

    Author {
        ID IDAuthor PK
        Numeric IDUser FK
        Numeric IDCustomer FK
        String Name
    }

    BookAuthorJoin {
        ID IDBookAuthorJoin PK
        Numeric IDBook FK
        Numeric IDAuthor FK
        Numeric IDCustomer FK
    }

    BookPrice {
        ID IDBookPrice PK
        Numeric IDBook FK
        Numeric IDCustomer FK
        Decimal Price
        DateTime StartDate
        DateTime EndDate
        Boolean Discountable
        String CouponCode
    }

    BookStore {
        ID IDBookStore PK
        Numeric IDCustomer FK
        String Name
        String StoreType
        String Address
        String City
        String State
        String Postal
        String Country
        String Phone
        String Email
    }

    BookStoreInventory {
        ID IDBookStoreInventory PK
        Numeric IDBook FK
        Numeric IDBookStore FK
        Numeric IDBookPrice FK
        Numeric StockingAssociate FK
        Numeric IDCustomer FK
        DateTime StockDate
        Numeric BookCount
        Numeric AggregateBookCount
    }

    BookStoreEmployee {
        ID IDBookStoreEmployee PK
        Numeric IDUser FK
        Numeric IDBookStore FK
        Numeric IDCustomer FK
        String Title
        DateTime HireDate
        DateTime TerminationDate
        Boolean IsActive
    }

    BookStoreSale {
        ID IDBookStoreSale PK
        Numeric IDBookStore FK
        Numeric IDUser FK
        Numeric IDCustomer FK
        DateTime SaleDate
        Decimal TotalAmount
        String PaymentMethod
        String TransactionID
    }

    BookStoreSaleItem {
        ID IDBookStoreSaleItem PK
        Numeric IDBookStoreSale FK
        Numeric IDBook FK
        Numeric IDBookPrice FK
        Numeric IDCustomer FK
        Numeric Quantity
        Decimal UnitPrice
        Decimal LineTotal
    }

    Review {
        ID IDReview PK
        Numeric IDBook FK
        Numeric IDUser FK
        Numeric IDCustomer FK
        Text Text
        Numeric Rating
    }
